{
  "name": "projeto-3-periodo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "validate:push": "npm --prefix Projeto-back-end test && npm --prefix Projeto-front-end test -- --watchAll=false --runInBand"
  },
  "devDependencies": {
    "commitlint": "^17.0.0",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "husky": "^8.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no-install commitlint --edit $HUSKY_GIT_PARAMS",
      "pre-push": "npm run validate:push"
    }
  }
}
