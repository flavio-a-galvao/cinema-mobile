
DB_ROOT_PASSWORD=change_me
DB_NAME=cinema_db
DB_USER=app
DB_PASS=change_me
DB_HOST=database
DB_PORT=3306


PORT=3000
NODE_ENV=development

# Docker: hostname do serviço; fora do Docker, use o endereço acessível do Redis.
# Sem REDIS_URL, a API consulta diretamente o banco.
REDIS_URL=redis://redis:6379
# Tempo de vida das respostas públicas, em segundos (inteiro positivo).
CACHE_TTL_SECONDS=60


REACT_APP_API_URL=https://cinema.local/api
