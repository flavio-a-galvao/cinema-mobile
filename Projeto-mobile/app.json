{
  "expo": {
    "name": "Cinemax",
    "slug": "cinema-mobile",
    "version": "1.0.0",
    "scheme": "cinema-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Cinemax selecione um poster da sua galeria.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
