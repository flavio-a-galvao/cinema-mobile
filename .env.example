
DB_ROOT_PASSWORD=change_me
DB_NAME=cinema_db
DB_USER=app
DB_PASS=change_me
DB_HOST=database
DB_PORT=3306


PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_use_a_long_random_secret

# Docker: hostname do serviço; fora do Docker, use o endereço acessível do Redis.
# Cache e Pub/Sub reutilizam esta URL; Pub/Sub usa sockets dedicados.
# Sem REDIS_URL, a API consulta o banco e não publica/assina eventos.
REDIS_URL=redis://redis:6379
# Tempo de vida das respostas públicas, em segundos (inteiro positivo).
CACHE_TTL_SECONDS=60


REACT_APP_API_URL=/api
# Diretório com cinema.local.crt e cinema.local.key (não versionar chaves).
TLS_CERTS_DIR=./certs/local
# Opcional: arquivo lido pelo env_file do backend, também passado a --env-file.
ENV_FILE=.env
